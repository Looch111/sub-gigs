# SubsGigs Account Credentials
SUBSGIGS_USERNAME=@yourhandle
SUBSGIGS_PASSWORD=yourpassword

# Scan Interval in seconds (default: 10)
CHECK_INTERVAL_SECONDS=10

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=+234XXXXXXXXXX,+234XXXXXXXXXX

# Optional Additional Channels
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional: Custom Chrome/Chromium Executable Path (Leave empty for automatic detection)
# Linux VPS/Pterodactyl example: /usr/bin/chromium or /usr/bin/chromium-browser or /usr/bin/google-chrome-stable
# PUPPETEER_EXECUTABLE_PATH=

